{
  "name": "lner-carriage-working-rotation-planner",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "web": "vite --host 0.0.0.0",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "db:generate": "prisma generate",
    "db:migrate": "tsx server/migrate.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write \"server/*.ts\" \"web/*.{tsx,css}\" \"tests/*.ts\" \"*.{json,ts,yaml,md}\" \"docs/*.md\""
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "@prisma/adapter-pg": "6.19.0",
    "@prisma/client": "6.19.0",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "prettier": "3.9.10",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0"
  }
}
