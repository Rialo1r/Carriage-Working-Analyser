generator client {
 provider = "prisma-client-js"
 engineType = "client"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
model HistoricalPeriod {
 archived Boolean @default(false)
 id String @id @default(uuid()) @db.Uuid
 name String
 startDate DateTime? @db.Date
 endDate DateTime? @db.Date
 notes String @default("")
 diagrams PublishedDiagram[]
}
model PublishedDiagram {
 archived Boolean @default(false)
 id String @id @default(uuid()) @db.Uuid
 periodId String @db.Uuid
 period HistoricalPeriod @relation(fields:[periodId],references:[id],onDelete:Restrict)
 number String
 description String @default("")
 revision Int @default(1)
 createdAt DateTime @default(now())
 workings WorkingDefinition[]
 @@index([periodId, number])
}
model Station {
 archived Boolean @default(false)
 revision Int @default(1)
 id String @id @default(uuid()) @db.Uuid
 name String
 notes String @default("")
 starts WorkingDefinition[] @relation("start")
 finishes WorkingDefinition[] @relation("finish")
 routeCalls RouteCall[]
 @@index([name])
}
model CarriageType {
 archived Boolean @default(false)
 revision Int @default(1)
 id String @id @default(uuid()) @db.Uuid
 name String
 code String?
 notes String @default("")
 members FormationMember[]
 changes FormationChange[]
}
model Formation {
 archived Boolean @default(false)
 id String @id @default(uuid()) @db.Uuid
 name String
 completeness String @default("Unknown")
 notes String @default("")
 revision Int @default(1)
 createdAt DateTime @default(now())
 members FormationMember[]
 workings WorkingDefinition[]
 variations FormationVariation[]
}
model FormationMember {
 id String @id @default(uuid()) @db.Uuid
 formationId String @db.Uuid
 formation Formation @relation(fields:[formationId],references:[id],onDelete:Restrict)
 typeId String? @db.Uuid
 type CarriageType? @relation(fields:[typeId],references:[id],onDelete:Restrict)
 quantity Int?
 position Int?
 vehicleNumber String?
 notes String @default("")
}
model WorkingDefinition {
 archived Boolean @default(false)
 id String @id @default(uuid()) @db.Uuid
 diagramId String @db.Uuid
 diagram PublishedDiagram @relation(fields:[diagramId],references:[id],onDelete:Restrict)
 label String @default("")
 startStationId String? @db.Uuid
 startStation Station? @relation("start",fields:[startStationId],references:[id],onDelete:Restrict)
 finishStationId String? @db.Uuid
 finishStation Station? @relation("finish",fields:[finishStationId],references:[id],onDelete:Restrict)
 startMinutes Int?
 finishMinutes Int?
 startDayOffset Int @default(0)
 finishDayOffset Int @default(0)
 formationId String? @db.Uuid
 formation Formation? @relation(fields:[formationId],references:[id],onDelete:Restrict)
 routeText String @default("")
 notes String @default("")
 exclusive Boolean @default(true)
 revision Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 calendar OperatingCalendar?
 routeCalls RouteCall[]
 instructions SpecialInstruction[]
 variations FormationVariation[]
 changes FormationChange[]
 sources SourceReference[]
 nextRules NextWorkingReference[] @relation("ruleFrom")
 incomingRules NextWorkingReference[] @relation("ruleTo")
 occurrences WorkingOccurrence[]
 researchNotes ResearchNote[]
 @@index([diagramId])
}
model OperatingCalendar {
 id String @id @default(uuid()) @db.Uuid
 workingId String @unique @db.Uuid
 working WorkingDefinition @relation(fields:[workingId],references:[id],onDelete:Restrict)
 weekdays Int[]
 cycleWeeks Int @default(1)
 anchorDate DateTime? @db.Date
 weekOffsets Int[] @default([0])
 validFrom DateTime? @db.Date
 validTo DateTime? @db.Date
 notes String @default("")
 exceptions CalendarException[]
}
model CalendarException {
 id String @id @default(uuid()) @db.Uuid
 calendarId String @db.Uuid
 calendar OperatingCalendar @relation(fields:[calendarId],references:[id],onDelete:Restrict)
 date DateTime @db.Date
 operates Boolean
 notes String
 @@unique([calendarId,date])
}
model RouteCall {
 id String @id @default(uuid()) @db.Uuid
 workingId String @db.Uuid
 working WorkingDefinition @relation(fields:[workingId],references:[id],onDelete:Restrict)
 stationId String @db.Uuid
 station Station @relation(fields:[stationId],references:[id],onDelete:Restrict)
 sequence Int
 notes String @default("")
 @@unique([workingId,sequence])
}
model SpecialInstruction {
 id String @id @default(uuid()) @db.Uuid
 workingId String @db.Uuid
 working WorkingDefinition @relation(fields:[workingId],references:[id],onDelete:Restrict)
 weekdays Int[]
 text String
}
model FormationVariation {
 id String @id @default(uuid()) @db.Uuid
 workingId String @db.Uuid
 working WorkingDefinition @relation(fields:[workingId],references:[id],onDelete:Restrict)
 weekday Int
 formationId String? @db.Uuid
 formation Formation? @relation(fields:[formationId],references:[id],onDelete:Restrict)
 notes String
 @@unique([workingId,weekday])
}
model FormationChange {
 id String @id @default(uuid()) @db.Uuid
 workingId String @db.Uuid
 working WorkingDefinition @relation(fields:[workingId],references:[id],onDelete:Restrict)
 weekdays Int[]
 action String
 stage String
 typeId String? @db.Uuid
 type CarriageType? @relation(fields:[typeId],references:[id],onDelete:Restrict)
 quantity Int?
 notes String
}
model SourceReference {
 id String @id @default(uuid()) @db.Uuid
 workingId String @db.Uuid
 working WorkingDefinition @relation(fields:[workingId],references:[id],onDelete:Restrict)
 title String
 sourceDate String?
 page String?
 notes String @default("")
}
model NextWorkingReference {
 id String @id @default(uuid()) @db.Uuid
 workingId String @db.Uuid
 working WorkingDefinition @relation("ruleFrom",fields:[workingId],references:[id],onDelete:Restrict)
 weekday Int
 kind String
 targetWorkingId String? @db.Uuid
 targetWorking WorkingDefinition? @relation("ruleTo",fields:[targetWorkingId],references:[id],onDelete:Restrict)
 enteredNumber String?
 offsetDays Int?
 targetWeekday Int?
 targetDate DateTime? @db.Date
 storageStationId String? @db.Uuid
 verified Boolean @default(false)
 notes String @default("")
 @@unique([workingId,weekday])
}
model WorkingOccurrence {
 id String @id @default(uuid()) @db.Uuid
 workingId String @db.Uuid
 working WorkingDefinition @relation(fields:[workingId],references:[id],onDelete:Restrict)
 date DateTime @db.Date
 createdAt DateTime @default(now())
 assignments RotationAssignment[]
 outgoing OccurrenceReference? @relation("occFrom")
 incoming OccurrenceReference[] @relation("occTo")
 @@unique([workingId,date])
}
model OccurrenceReference {
 id String @id @default(uuid()) @db.Uuid
 fromId String @unique @db.Uuid
 from WorkingOccurrence @relation("occFrom",fields:[fromId],references:[id],onDelete:Restrict)
 toId String? @db.Uuid
 to WorkingOccurrence? @relation("occTo",fields:[toId],references:[id],onDelete:Restrict)
 kind String
 note String
}
model PhysicalSet {
 archived Boolean @default(false)
 id String @id @default(uuid()) @db.Uuid
 serial Int @unique @default(autoincrement())
 label String @default("")
 notes String @default("")
 createdAt DateTime @default(now())
 assignments RotationAssignment[]
}
model RotationAssignment {
 id String @id @default(uuid()) @db.Uuid
 physicalSetId String @db.Uuid
 physicalSet PhysicalSet @relation(fields:[physicalSetId],references:[id],onDelete:Restrict)
 occurrenceId String @db.Uuid
 occurrence WorkingOccurrence @relation(fields:[occurrenceId],references:[id],onDelete:Restrict)
 exclusiveKey String? @unique @db.Uuid
 active Boolean @default(true)
 notes String
 definitionRevision Int
 createdAt DateTime @default(now())
 @@unique([physicalSetId,occurrenceId])
}
model ResearchNote {
 id String @id @default(uuid()) @db.Uuid
 workingId String @db.Uuid
 working WorkingDefinition @relation(fields:[workingId],references:[id],onDelete:Restrict)
 text String
 createdAt DateTime @default(now())
}
model AuditEvent {
 id String @id @default(uuid()) @db.Uuid
 entityId String @db.Uuid
 entityType String
 action String
 reason String
 before Json?
 after Json?
 createdAt DateTime @default(now())
 @@index([entityId,createdAt])
}

model DatasetState {
 id String @id
 version Int @default(0)
}
