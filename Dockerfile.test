# syntax=docker/dockerfile:1
FROM lner-rotation-planner:phase1
USER root
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then apt_extra="-o Acquire::https::CaInfo=/run/secrets/proxy_ca"; else apt_extra=""; fi; \
    apt-get $apt_extra update && apt-get $apt_extra install -y --no-install-recommends chromium && rm -rf /var/lib/apt/lists/*
USER node
ENV NODE_ENV=test BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
CMD ["sh","-c","npm test && npm run test:browser"]
